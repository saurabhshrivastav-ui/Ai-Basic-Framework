# Copy this file to ".env" and adjust values as needed.
# conftest.py / utils/config.py load this automatically via python-dotenv.

# The application under test. Never hardcode this inside a test file -
# that is what utils/config.py + this variable are for.
BASE_URL=https://www.saucedemo.com/

# chromium | firefox | webkit
BROWSER=chromium

# true = run invisibly (faster, good for CI). false = watch it click around.
HEADLESS=true

DEFAULT_TIMEOUT_MS=10000

# Phase 2 switch - leave as "none" until you wire in a real AI provider
# in utils/ai_client.py (see the comments in that file).
AI_PROVIDER=none
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# ---- Used by agents/orchestrator.py --story (the "brain") ----
# The short name given to BASE_URL's own landing page when the
# orchestrator discovers it automatically (change if it's not a login
# screen, e.g. "home").
ENTRY_PAGE_NAME=login

# Only needed if you use --pages to auto-discover pages that sit behind
# a login wall (e.g. an inventory/dashboard page). Never used inside a
# generated test itself - only to log in while discovering.
DEMO_USERNAME=
DEMO_PASSWORD=